<?xml version="1.0" encoding="utf-8"?>
<!--
    Backups are disabled in the manifest because wallet keys, pairing identity,
    and auth/session state are device-bound. Keep this file restrictive as well
    so a future manifest change cannot silently export security-sensitive data.
-->
<full-backup-content>
    <exclude domain="database" path="vigia_db" />
    <exclude domain="sharedpref" path="vigia_wallet_v1.xml" />
    <exclude domain="sharedpref" path="osmdroid.xml" />
    <exclude domain="file" path="datastore/" />
</full-backup-content>
