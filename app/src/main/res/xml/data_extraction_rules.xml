<?xml version="1.0" encoding="utf-8"?>
<!-- Security-sensitive state is device-bound; the manifest also disables backup. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="vigia_db" />
        <exclude domain="sharedpref" path="vigia_wallet_v1.xml" />
        <exclude domain="sharedpref" path="osmdroid.xml" />
        <exclude domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="vigia_db" />
        <exclude domain="sharedpref" path="vigia_wallet_v1.xml" />
        <exclude domain="sharedpref" path="osmdroid.xml" />
        <exclude domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
